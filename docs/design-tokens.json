      "order-total":   { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "letterSpacing": "-0.04em", "lineHeight": 1.3, "fontSize": { "desktop": "20px", "mobile": "unverified" } } },
      "section-title": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 500, "letterSpacing": "-0.04em", "lineHeight": "normal", "fontSize": { "desktop": "25px", "mobile": "14px" } }, "$extensions": { "carnet.usage": "상품 Q&A (카운트 '(5)'는 같은 크기 Regular)" } },
