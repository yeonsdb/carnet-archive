      "muted":     { "$value": "{color.primitive.gray-550}", "$extensions": { "carnet.status": "variable", "carnet.figmaVar": "color/text/muted", "carnet.usage": "비활성 탭, 정렬 옵션, 비활성 문의 필터, INCH, 안내 각주" } },
