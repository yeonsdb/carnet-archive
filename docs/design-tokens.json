      "muted":        { "$value": "{color.primitive.gray-550}", "$extensions": { "carnet.status": "measured", "carnet.usage": "PC 비활성 탭 하단선, 비활성 문의 필터 테두리" } },
      "tab-inactive": { "$value": "{color.primitive.gray-550}", "$extensions": { "carnet.status": "decided", "carnet.figmaVar": "color/border/tab-inactive", "carnet.note": "2026-10-09 결정: PC·모바일 비활성 탭 테두리 #8B8B8B로 통일. 기존 Figma 변수 값(→color/A4A4A4)과 모바일 상세 탭 3곳의 #A4A4A4는 이 결정에 맞춰 갱신 대상" } },
      "subtle":       { "$value": "{color.primitive.gray-300}", "$extensions": { "carnet.status": "variable", "carnet.figmaVar": "color/border/subtle", "carnet.usage": "수량 스테퍼, 상세 보조 구분선" } },
      "accent":       { "$value": "{color.primitive.red-900}",  "$extensions": { "carnet.status": "measured", "carnet.usage": "1ST DROP NEW IN 버튼 테두리, 아이콘 선" } }
