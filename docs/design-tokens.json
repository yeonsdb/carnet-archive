    "category-portrait":  { "$value": "3 / 4", "$extensions": { "carnet.measured": "ALL 587x783, TOPS 708x944 / 361x482, 176x235" } },
    "category-landscape": { "$value": "465 / 357", "$extensions": { "carnet.measured": "465x357, 587x451 (≈1.30) / 177x136, 176x135", "carnet.note": "표준 4:3(1.333)이 아닌 약 1.30. 의도된 비율인지 확인 필요" } },
