    "4":   { "$value": "4px",   "$extensions": { "carnet.figmaVar": "spacing/4", "carnet.usage": "Stockist 이름-도시 gap" } },
    "5":   { "$value": "5px",   "$extensions": { "carnet.figmaVar": "spacing/5", "carnet.usage": "상품명-가격, 스와치 간격, 날짜-배지, 모바일 문의필터 gap" } },
    "6":   { "$value": "6px",   "$extensions": { "carnet.status": "measured", "carnet.usage": "모바일 상품 이미지-메타 간격" } },
