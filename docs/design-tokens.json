    "detail-gallery-active": { "$value": "436 / 889", "$extensions": { "carnet.measured": "436x889 / 187x380 (0.49)" } },
    "detail-gallery-item":   { "$value": "unverified", "$extensions": { "carnet.measured": "265x597, 272x597, 283x586, 226x589 등 컷아웃마다 상이 (0.38~0.48)" } }
