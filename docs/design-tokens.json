    "13":  { "$value": "13px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "PC Footer 필드 행 간격(21px 텍스트, 34px 피치)" } },
    "14":  { "$value": "14px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "모바일 카드 메타 스와치-아이콘 gap" } },
    "15":  { "$value": "15px",  "$extensions": { "carnet.status": "measured", "carnet.figmaVar": "layout/product-meta-gap", "carnet.usage": "PC 상품 이미지-메타 간격, Footer Contact 행 간격" } },
    "16":  { "$value": "16px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "모바일 페이지 좌우 여백" } },
    "19":  { "$value": "19px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "모바일 섹션 헤딩-콘텐츠, 카테고리 카드 행 간격" } },
    "20":  { "$value": "20px",  "$extensions": { "carnet.figmaVar": "spacing/20", "carnet.usage": "PC 열 gutter, 메타 행 gap, 모바일 문의 블록 gap" } },
    "23":  { "$value": "23px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "문의 필터 좌우 padding" } },
    "24":  { "$value": "24px",  "$extensions": { "carnet.figmaVar": "spacing/24" } },
    "28":  { "$value": "28px",  "$extensions": { "carnet.figmaVar": "spacing/28", "carnet.usage": "문의 행 내부 세로 gap" } },
    "29":  { "$value": "29px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "모바일 상품 카드 간 세로 간격(메타 하단→다음 이미지)" } },
    "30":  { "$value": "30px",  "$extensions": { "carnet.figmaVar": "spacing/30" } },
    "40":  { "$value": "40px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "PC 섹션 헤딩(80px)-콘텐츠 간격 (SHOP, STOCKISTS)" } },
    "45":  { "$value": "45px",  "$extensions": { "carnet.status": "measured", "carnet.usage": "PC 홈 카테고리 카드 행 간격" } },
